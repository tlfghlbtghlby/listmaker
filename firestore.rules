rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin check helper function (tlfghlbtghlby@gmail.com)
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'tlfghlbtghlby@gmail.com' || 
         request.auth.token.email.lower() == 'tlfghlbtghlby@gmail.com');
    }

    // Authenticated check
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile collection:
    // Only the primary admin (tlfghlbtghlby@gmail.com) can create, list, or delete user accounts.
    // Client users can only read their own user record.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);

      // User's private store collection (products, invoices, customers, settings)
      match /store/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Default: Only Admin can access any other collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
